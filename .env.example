# -------------------------------------------------------------
# ScholarStack Environment Configuration Example
# Copy this file to .env and fill in your real credentials.
# NEVER commit the real .env file to version control.
# -------------------------------------------------------------

# Sanity Organization & Project
SANITY_ORGANIZATION_ID=your_org_id_here
SANITY_PROJECT_ID=your_project_id_here
SANITY_DATASET=production

# Sanity API Tokens
# Org token with "Context Viewer" or "Editor" permissions (Manage -> Org -> API -> Tokens)
SANITY_ORG_TOKEN=your_sanity_org_token_here

# Project token with Editor/Write permissions for seeding & recording resolutions (Manage -> Project -> API -> Tokens)
SANITY_PROJECT_TOKEN=your_sanity_project_token_here

# Sanity Context App & MCP Endpoint
SANITY_CONTEXT_ENABLED=yes
SANITY_MCP_NAME=scholarstack-agent
SANITY_MCP_URL=https://...sanity.io/...

# Model Provider API Key (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
